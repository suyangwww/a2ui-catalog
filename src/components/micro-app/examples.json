  {
    "title": "MicroApp — Harmonic wave superposition interactive canvas",
    "props": {
      "title": "Harmonic Superposition Lab",
      "subtitle": "Adjust f2 ratio to observe constructive & destructive wave interference",
      "badge": "60 FPS CANVAS",
      "height": 260,
      "html": "<div style='padding:16px;display:flex;flex-direction:column;gap:12px'><div style='display:flex;justify-content:space-between;align-items:center;font-size:13px'><label style='display:flex;align-items:center;gap:8px;color:var(--viz-muted)'>Harmonic ratio <input id='r' type='range' min='1' max='4' step='0.05' value='1.5' /></label><strong id='v' style='font-variant-numeric:tabular-nums'>1.50×</strong></div><canvas id='c' width='560' height='160' style='width:100%;height:160px;border-radius:10px;background:var(--viz-panel);border:1px solid var(--viz-border)'></canvas></div><script>const c=document.getElementById('c'),x=c.getContext('2d'),r=document.getElementById('r'),v=document.getElementById('v');let t=0;r.oninput=()=>v.textContent=Number(r.value).toFixed(2)+'×';function draw(){const cs=getComputedStyle(document.documentElement);x.clearRect(0,0,560,160);x.strokeStyle=cs.getPropertyValue('--viz-accent')||'#0071e3';x.lineWidth=2.4;x.beginPath();const k=Number(r.value);for(let i=0;i<=560;i+=2){const p=i*0.032;const y=80+Math.sin(p-t)*30+Math.sin(p*k-t*1.3)*26;i===0?x.moveTo(i,y):x.lineTo(i,y);}x.stroke();t+=0.035;requestAnimationFrame(draw);}draw();</script>"
    }
