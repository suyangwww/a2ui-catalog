{
  "name": "a2ui-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm --filter @a2ui-catalog/tokens build && pnpm --filter @a2ui-catalog/core build && pnpm --filter @a2ui-catalog/schema build && pnpm --filter @a2ui-catalog/react build && pnpm build:catalog && pnpm --filter @a2ui-catalog/agent build && pnpm --filter @a2ui-catalog/explorer build && pnpm --filter @a2ui-catalog/studio build",
    "build:packages": "pnpm --filter @a2ui-catalog/tokens build && pnpm --filter @a2ui-catalog/core build && pnpm --filter @a2ui-catalog/schema build && pnpm --filter @a2ui-catalog/react build",
    "build:catalog": "tsx src/catalog/compiler.ts",
    "lint": "eslint src && depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:e2e": "playwright test && playwright test -c playwright.smoke.config.ts",
    "quality:score": "node scripts/compute-quality-score.mjs",
    "gc:knip": "knip --no-progress",
    "dev": "concurrently -n agent,studio,explorer -c magenta,cyan,green \"pnpm --filter @a2ui-catalog/agent dev\" \"pnpm --filter @a2ui-catalog/studio dev\" \"pnpm --filter @a2ui-catalog/explorer dev\"",
    "sync:spec": "node packages/schema/scripts/sync-upstream-spec.mjs",
    "clean": "rm -rf dist .tmp && pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "jsdom": "^26.0.0",
    "knip": "^6.46.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@a2ui-catalog/tokens": "workspace:*",
    "@a2ui/agent": "^0.1.0",
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/react": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.76.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  }
}
